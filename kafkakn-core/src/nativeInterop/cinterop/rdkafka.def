# The C surface the native arm is built on.
#
# No paths here on purpose: the include directory and the static archives are handed in by
# build.gradle.kts, so this file is the same whoever builds it and wherever their cache lives - and
# a second native target costs a build-matrix row rather than an edit (research D6).
#
# rd_kafka_producev is deliberately never used: it is variadic, and a variadic C function has no
# usable shape through cinterop (research §1.5). rd_kafka_produce is the non-variadic equivalent.

headers = librdkafka/rdkafka.h
headerFilter = librdkafka/**
package = rdkafka

# THE ARCHIVES GO INTO THE KLIB, and this line is the difference between a library a stranger can
# link and one only this repository can. Named without paths, exactly like the headers above: the
# directories come from build.gradle.kts as `-libraryPath`, so the file stays the same wherever the
# bundle is cached.
#
# Measured by B-13: with only the bindings published, a consumer resolved the artefact, compiled
# against it, and then got nine undefined symbols from the linker - `rd_kafka_produceva`,
# `rd_kafka_poll` and the rest. This project's own tests linked, because its build file names the
# archives on its own test binaries, so every check was green and none could see it.
staticLibraries = librdkafka-static.a libssl.a libcrypto.a libz.a libzstd.a
